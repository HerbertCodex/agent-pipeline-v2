{
  "name": "agent-pipeline-v3",
  "gates": [
    {
      "id": "typecheck",
      "command": [
        "npm",
        "run",
        "typecheck"
      ],
      "timeoutMs": 300000,
      "mandatory": true,
      "covers": [
        "typecheck"
      ]
    },
    {
      "id": "build",
      "command": [
        "npm",
        "run",
        "build"
      ],
      "timeoutMs": 300000,
      "mandatory": true,
      "outputs": [
        "dist/**"
      ]
    },
    {
      "id": "test",
      "command": [
        "npm",
        "test"
      ],
      "dependsOn": [
        "build"
      ],
      "timeoutMs": 900000,
      "mandatory": true,
      "covers": [
        "unit"
      ],
      "testPaths": [
        "test/**"
      ]
    }
  ],
  "stack": {
    "keepBranches": [
      "apv3",
      "develop",
      "development",
      "release/*",
      "releases/*",
      "staging",
      "hotfix/*"
    ]
  },
  "rules": {
    "docsOnly": {
      "exclude": [
        "docs/*.md",
        "examples/**"
      ]
    }
  }
}
