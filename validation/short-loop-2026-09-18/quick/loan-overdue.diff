--- a/src/dates.mjs
+++ b/src/dates.mjs
@@ -1 +1,38 @@
-export function isOverdue(dueOn,today) { return today >= dueOn; }
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+function isLeapYear(year) {
+  return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+}
+
+const DAYS_IN_MONTH = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+function validate(value) {
+  if (typeof value !== "string") {
+    throw new RangeError(`Expected a date string, received ${typeof value}`);
+  }
+  const match = DATE_RE.exec(value);
+  if (!match) {
+    throw new RangeError(`Invalid date format: ${value}`);
+  }
+  const year = Number(match[1]);
+  const month = Number(match[2]);
+  const day = Number(match[3]);
+  if (year < 1000 || year > 9999) {
+    throw new RangeError(`Year out of range: ${value}`);
+  }
+  if (month < 1 || month > 12) {
+    throw new RangeError(`Invalid month: ${value}`);
+  }
+  const maxDay =
+    month === 2 && isLeapYear(year) ? 29 : DAYS_IN_MONTH[month - 1];
+  if (day < 1 || day > maxDay) {
+    throw new RangeError(`Invalid day: ${value}`);
+  }
+  return { year, month, day };
+}
+
+export function isOverdue(dueOn, today) {
+  validate(dueOn);
+  validate(today);
+  return today > dueOn;
+}
