+/**
+ * Parses a loan record identifier.
+ * @param {unknown} raw - Candidate identifier.
+ * @returns {number|null} A positive safe integer for a valid 1-16 digit
+ *   string with no leading zero, or null otherwise.
+ */
+export function parseRecordId(raw) {
+  if (typeof raw !== 'string' || !/^[1-9][0-9]{0,15}$/.test(raw)) return null;
+  const value = Number(raw);
+  return Number.isSafeInteger(value) ? value : null;
+}
