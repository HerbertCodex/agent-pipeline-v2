{
  "name": "agent-pipeline-v2",
  "version": "3.0.0-alpha.1",
  "description": "Agent Pipeline V3: Claude Code plugin tooling (specs, decision ledger, gates, scope, quota) without the V2 controller",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "apv": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "src",
    "test",
    "validation",
    "CHANGELOG.md",
    "tsconfig.json",
    "prompts",
    "START-HERE.md",
    "roles",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=4 test/*.test.mjs",
    "test:built": "node --test --test-concurrency=4 test/*.test.mjs",
    "check": "npm run typecheck && npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.0.4",
    "fast-check": "^4.10.1",
    "stylelint": "17.15.0",
    "typescript": "5.8.3"
  },
  "private": true
}
