{
  "description": "Garde-fous et reprise d'Agent Pipeline V3 : contexte de reprise au démarrage, journal des mots tapés par l'opérateur (trace que les agents ne peuvent pas écrire), blocage du force-push, de la fusion hors du chef de projet et hors commande dédiée, du déploiement en production et des écritures GitHub à sortie masquée, relecture enregistrée par le seul agent relecteur du domaine, magasins de l'opérateur et des relectures fermés aux agents, gardes du harnais (arrêt de la session ou de ses parents, killall et pkill -f, installation à travers un node_modules lié, Docker ou Supabase sur une pile de test sans son verrou, écriture Supabase sur une base distante), rappel des chemins autorisés après chaque écriture d'un implementer, journal de fin de tour.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/operator-journal.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash-guard.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/write-guard.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scope-reminder.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review-seal.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-journal.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
