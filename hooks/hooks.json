{
  "description": "Garde-fous et reprise d'Agent Pipeline V3 : contexte de reprise au démarrage, blocage du force-push, de la fusion, du déploiement en production et des écritures GitHub à sortie masquée, gardes du harnais (arrêt de la session ou de ses parents, killall et pkill -f, installation à travers un node_modules lié, Docker ou Supabase sur une pile de test sans son verrou), rappel des chemins autorisés après chaque écriture d'un implementer, journal de fin de tour.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-start.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash-guard.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scope-reminder.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-journal.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
