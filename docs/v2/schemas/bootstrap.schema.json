{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectType": {
      "type": "string",
      "enum": [
        "unknown",
        "backend",
        "frontend",
        "mobile",
        "fullstack",
        "library"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000,
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "architecture": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 6000,
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            }
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "allOf": [
                  {
                    "pattern": "^[^\\u0000]*$"
                  }
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 10,
                "maxLength": 4000,
                "allOf": [
                  {
                    "pattern": "^[^\\u0000]*$"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "option": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "allOf": [
                        {
                          "pattern": "^[^\\u0000]*$"
                        }
                      ]
                    },
                    "reasonNotChosen": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000,
                      "allOf": [
                        {
                          "pattern": "^[^\\u0000]*$"
                        }
                      ]
                    }
                  },
                  "required": [
                    "option",
                    "reasonNotChosen"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 20
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ]
                },
                "minItems": 0,
                "maxItems": 20
              },
              "reconsiderWhen": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              }
            },
            "required": [
              "decision",
              "rationale",
              "evidence",
              "alternatives",
              "tradeoffs",
              "reconsiderWhen"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "summary",
        "decisions"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "bootstrap",
              "product",
              "deferred"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "proposed",
              "ambiguous",
              "deferred"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "operator",
              "derived"
            ]
          },
          "sourceQuote": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "default": ""
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 20,
            "default": []
          },
          "clarificationQuestion": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "default": ""
          },
          "interpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 0,
            "maxItems": 10,
            "default": []
          }
        },
        "required": [
          "id",
          "subject",
          "value",
          "enforcement",
          "status",
          "source",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "decisionCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "deferred",
              "conflict",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "file",
                    "architecture",
                    "constraint",
                    "acceptance"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "reference",
                "detail"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 30
          }
        },
        "required": [
          "decisionId",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "allOf": [
          {
            "pattern": "^[^\\u0000]*$"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 50
    },
    "productQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "allOf": [
          {
            "pattern": "^[^\\u0000]*$"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100,
      "default": []
    },
    "deferredQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "allOf": [
          {
            "pattern": "^[^\\u0000]*$"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100,
      "default": []
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "allOf": [
          {
            "pattern": "^[^\\u0000]*$"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "projectType",
    "summary",
    "architecture",
    "decisions",
    "decisionCoverage",
    "files",
    "questions",
    "notes"
  ],
  "additionalProperties": false
}
