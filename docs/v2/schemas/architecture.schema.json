{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "constraint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "\\S"
          },
          "simplerAlternative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "\\S"
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 5
          },
          "reconsiderWhen": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "required": [
          "decision",
          "rationale",
          "constraint",
          "simplerAlternative",
          "risks",
          "alternatives",
          "tradeoffs",
          "reconsiderWhen"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
    },
    "inspection": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "path",
          "finding"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "summary",
    "decisions",
    "inspection"
  ],
  "additionalProperties": false
}
