{
  "schemaVersion": 1,
  "executionMode": "local-trusted",
  "environment": {
    "id": "REPLACE-with-reviewed-environment"
  },
  "agent": {
    "type": "claude",
    "passEnv": [
      "HOME",
      "CLAUDE_CONFIG_DIR",
      "ANTHROPIC_API_KEY",
      "CLAUDE_CODE_OAUTH_TOKEN"
    ],
    "maxTurns": 200,
    "maxBudgetUsd": null
  },
  "roles": {
    "product": null,
    "qa": {
      "type": "codex",
      "passEnv": [
        "HOME",
        "CODEX_HOME",
        "CODEX_API_KEY"
      ]
    }
  },
  "skills": {
    "enabled": [
      "clean-code",
      "security",
      "tdd",
      "refactoring"
    ],
    "projectType": "backend",
    "maxContextBytes": 16000
  },
  "gates": [
    {
      "id": "diff-check",
      "command": [
        "git",
        "diff",
        "--check",
        "{{baseSha}}",
        "{{candidateSha}}"
      ],
      "mandatory": true
    },
    {
      "id": "test",
      "command": [
        "npm",
        "test"
      ],
      "lanes": [
        "standard",
        "high"
      ]
    }
  ]
}
