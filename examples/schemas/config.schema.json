        "qa": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "command",
                    "codex",
                    "claude"
                  ]
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16000,
                    "allOf": [
                      {
                        "pattern": "^[^\\u0000]*$"
                      }
                    ]
                  },
                  "minItems": 0,
                  "maxItems": 200,
                  "default": []
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 3600000,
                  "default": 900000
                },
                "passEnv": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "allOf": [
                      {
                        "pattern": "^[^\\u0000]*$"
                      }
