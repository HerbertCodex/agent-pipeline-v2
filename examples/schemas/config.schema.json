          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "default": []
