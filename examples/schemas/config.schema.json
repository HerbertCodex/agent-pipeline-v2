                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "allOf": [
                      {
                        "pattern": "^[^\\u0000]*$"
                      }
                    ],
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
