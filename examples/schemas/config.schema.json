                  "minItems": 0,
                  "maxItems": 100,
                  "default": []
                },
                "model": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 200,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000]*$"
                    }
                  ],
                  "default": ""
                },
                "maxTurns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200,
                  "default": 32
                },
                "maxBudgetUsd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1000
                    },
                    {
                      "type": "null"
                    }
