    "schemaVersion": {
      "const": 1
    },
    "executionMode": {
      "const": "local-trusted"
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "allOf": [
            {
              "pattern": "^[^\\u0000]*$"
            }
          ]
        },
        "passEnv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "minItems": 0,
          "maxItems": 100,
          "default": [
            "PATH",
            "SystemRoot",
            "WINDIR",
            "TMPDIR",
            "TEMP",
            "TMP",
            "LANG"
          ]
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "command",
            "codex",
            "claude"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 200,
          "default": []
