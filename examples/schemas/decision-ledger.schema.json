{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "bootstrap",
              "product",
              "deferred"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "proposed",
              "ambiguous",
              "deferred"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "operator",
              "derived"
            ]
          },
          "sourceQuote": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "default": ""
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 20,
            "default": []
          },
          "clarificationQuestion": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "default": ""
          },
          "interpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 0,
            "maxItems": 10,
            "default": []
          }
        },
        "required": [
          "id",
          "subject",
          "value",
          "enforcement",
          "status",
          "source",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    }
  },
  "required": [
    "schemaVersion",
    "decisions"
  ],
  "additionalProperties": false
}
