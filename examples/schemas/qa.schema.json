{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "candidateSha": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ],
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "changes_requested"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "allOf": [
        {
          "pattern": "^[^\\u0000]*$"
        }
      ]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "id",
          "severity",
          "path",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000,
        "allOf": [
          {
            "pattern": "^[^\\u0000]*$"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "decisionChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "decisionId",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200,
      "default": []
    },
    "securityChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          }
        },
        "required": [
          "requirementId",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200,
      "default": []
    },
    "qualityChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "architecture",
              "simplicity",
              "reuse",
              "tests",
              "operations",
              "ui"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 0,
            "maxItems": 12
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "axis",
          "status",
          "evidence",
          "paths",
          "receiptIds",
          "findingIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6,
      "default": []
    },
    "negativeTestChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "testIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 29
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "review"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600,
            "allOf": [
              {
                "pattern": "^[^\\u0000]*$"
              }
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ]
            },
            "minItems": 0,
            "maxItems": 12
          },
          "receiptIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "allOf": [
                {
                  "pattern": "^[^\\u0000]*$"
                }
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 20
          }
        },
        "required": [
          "requirementId",
          "testIndex",
          "status",
          "evidence",
          "paths",
          "receiptIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3000,
      "default": []
    }
  },
  "required": [
    "candidateSha",
    "verdict",
    "summary",
    "criteria",
    "findings",
    "observations"
  ],
  "additionalProperties": false
}
